# Copia a .env para abrir el entorno local sin servicios externos.
LOCAL_DEMO=1
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PUBLIC_BASE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=

# Producción: LOCAL_DEMO=0, DJANGO_DEBUG=0 y valores reales.
# Conexión directa o pooler de sesión. Certificado verificado por libpq.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_SCHEMA=resive
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=ResiVe <noreply@example.com>
# Activa solo detrás de un proxy propio que sobrescriba la cabecera SSL.
TRUST_PROXY_SSL=0

# Cliente OAuth tipo aplicación web en Google Cloud; vacío desactiva los botones.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
